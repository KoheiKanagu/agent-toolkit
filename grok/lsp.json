{
  "dart": {
    "command": "fvm",
    "args": [
      "dart",
      "language-server",
      "--protocol=lsp",
      "--client-id=grok",
      "--client-version=1.0"
    ],
    "extensionToLanguage": {
      ".dart": "dart"
    },
    "startupTimeout": 90000,
    "restartOnCrash": true,
    "maxRestarts": 3
  },
  "swift": {
    "command": "sourcekit-lsp",
    "extensionToLanguage": {
      ".swift": "swift"
    },
    "startupTimeout": 90000,
    "restartOnCrash": true,
    "maxRestarts": 3
  }
}
